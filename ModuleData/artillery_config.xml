<?xml version="1.0" encoding="utf-8"?>
<!-- =================================================================================
     КОНФИГУРАЦИЯ МОБИЛЬНОЙ ОРУДИЙНОЙ АРТИЛЛЕРИИ DWDN (ModuleData/artillery_config.xml)
     
     ОСОБЕННОСТИ ПЕРЕДВИЖНЫХ ОРУДИЙ:
     1. Спавн на базе команды при выборе заявки на орудие в экипировке артиллериста.
     2. Анти-дюп защита: 1 живое орудие на инженера, жесткий лимит на команду (max_cannons_per_team).
     3. Перемещение на колёсах: подход к задней части тележки -> [F] Толкать тележку.
     4. Боеприпасы: кучи снарядов спавнятся на земле рядом с орудием, сворачиваются при толкании тележки
        и вновь разворачиваются при остановке на боевую позицию.
     5. Нативное осадное взаимодействие: [F] за орудием, прицел, наведение, взвод, спуск, поднос снарядов.
     ================================================================================= -->
<ArtilleryConfig max_cannons_per_team="3" interact_radius_meters="3.5" push_speed="1.2" destroy_cooldown_seconds="25.0">
  <EngineTypes>
    <!-- 1. Передвижной Онагр (Камнемет на тележке с колесами, префаб mangonel_a) -->
    <EngineType id="mangonel" prefab_name="mangonel_a" trigger_item_id="dwdn_order_mangonel" name="Передвижной Онагр" max_hp="1400" push_speed="1.1" wheel_track_width="1.45" />

    <!-- 2. Передвижная Баллиста (Стреломет на тележке с колесами, префаб ballista_a) -->
    <EngineType id="ballista" prefab_name="ballista_a" trigger_item_id="dwdn_order_ballista" name="Передвижная Баллиста" max_hp="1100" push_speed="1.3" wheel_track_width="1.20" />
  </EngineTypes>
</ArtilleryConfig>
